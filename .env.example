# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your Groww credentials.
# Never commit .env - it is already in .gitignore.
# ---------------------------------------------------------------------------

# Trading mode: paper (default, no money at risk) or live
TRADING_MODE=paper

# Capital the paper account starts with (INR)
STARTING_CAPITAL=2500

# Risk profile: conservative | balanced | aggressive
RISK_LEVEL=balanced

# --- Groww API credentials (https://groww.in/trade-api/api-keys) -----------
# Option A: a daily access token (expires 6:00 AM IST)
GROWW_ACCESS_TOKEN=

# Option B: API key + secret (regenerates the token on startup)
GROWW_API_KEY=
GROWW_API_SECRET=

# Option C: TOTP flow (no expiry)
GROWW_TOTP_SECRET=

# --- market data -----------------------------------------------------------
# Groww's free plan has no quotes/candles, so prices come from the free Yahoo
# Finance feed. Use "simulated" for a fully offline demo.
DATA_SOURCE=yahoo
INSTRUMENT_SUFFIX=.NS

# --- engine tuning ---------------------------------------------------------
CANDLE_INTERVAL=1hour
CANDLE_MINUTES=60
LOOKBACK_BARS=120
POLL_SECONDS=20
CANDLE_REFRESH_SECONDS=60
MAX_PRICE_PER_SHARE=800
SLIPPAGE_PCT=0.0005

# Minutes to ignore a symbol after closing a position on it
COOLDOWN_MINUTES=30

# --- market screener -------------------------------------------------------
# Scans every NSE equity and keeps the best tradeable uptrends in the watchlist
AUTO_SCREEN=true
SCAN_SIZE=20
SCAN_CANDIDATES=80
SCAN_REFRESH_HOURS=12
MIN_TURNOVER_LACS=200
MIN_PRICE=20
MIN_DELIVERY_PCT=10

# Minimum target move (%) required to cover delivery charges (₹16.5 DP + ~0.3%)
MIN_EDGE_PCT=2.5

# Fully automatic: start trading as soon as the server boots
AUTO_START=false

# --- dashboard -------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
